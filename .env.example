# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=jungle
DB_PASS=jungle_password
DB_NAME=jungle_wagering

# AWS / LocalStack SQS
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SQS Queue URLs
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/integration-events.fifo

# Background Consumers & Workers
SQS_CONSUMER_ENABLED=true
WORKERS_ENABLED=true
SQS_MAX_RECEIVE_COUNT=3
PENDING_REF_MAX_ATTEMPTS=5
PENDING_REF_TTL_MS=60000
